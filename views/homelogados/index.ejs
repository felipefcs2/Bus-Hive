<!DOCTYPE html>
<html>

<head>
  <title>Home</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/estilo.css">
  <link rel="icon" type="image/png" href="../img/logo.png">
</head>

<body>
  <%- include('../partials/navlogado') %>

 <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="../img/banner.png" class="d-block w-100" alt="Banner 1">
      </div>
      <div class="carousel-item">
        <img src="../img/banner2.png" class="d-block w-100" alt="Banner 2">
      </div>
      <div class="carousel-item">
        <img src="../img/banner3.avif" class="d-block w-100" alt="Banner 3">
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>

    <div class="container mt-4">
      <!-- Título -->
      <div class="text-center mb-4">
        <h4 class="mb-1">Bem-vindo ao BusHive!</h4>
        <p class="mb-1">Nossos benefícios</p>
      </div>

      <!-- 📱 MOBILE (cards grandes) -->
      <div class="d-md-none">

        <div class="card card-home mb-3 shadow-sm">
          <div class="card-body card-body-type text-center">
            <h5 class="card-title">Mapas</h5>
            <p class="card-text text-muted">Nossa plataforma disponibilza sistema de rastreamento de ônibus com mapa interativo.</p>
          </div>
        </div>

        <div class="card card-home mb-3 shadow-sm">
          <div class="card-body card-body-type text-center">
            <h5 class="card-title">Horários</h5>
            <p class="card-text text-muted">Disponibilizamos um serviço de manejo de horários, possibilitando você organizar os seus horários.</p>
          </div>
        </div>

        <div class="card card-home mb-3 shadow-sm">
          <div class="card-body card-body-type text-center">
            <h5 class="card-title">Vale Transporte</h5>
            <p class="card-text text-muted">Fazemos o cadastro do seu vale transporte, contendo os serviços de consulta e recarga de valores.</p>
          </div>
        </div>

      </div>

      <!-- 🖥️ DESKTOP (grid) -->
      <div class="row d-none d-md-flex">

        <div class="col-md-4">
          <div class="card card-home shadow mb-3 h-100">
            <div class="card-body card-body-type text-center">
              <img src="/img/pinmapa.png" alt="Mapa" style="width: 125px; height: 125px;">
              <h5>Mapas</h5>
              <p>Nossa plataforma disponibilza sistema de rastreamento de ônibus com mapa interativo.</p>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card card-home shadow mb-3 h-100">
            <div class="card-body card-body-type text-center">
              <img src="../img/relogio.png" alt="Relógio">
              <h5>Horários</h5>
              <p>Disponibilizamos um serviço de manejo de horários, possibilitando você organizar os seus horários.</p>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card card-home shadow mb-3 h-100">
            <div class="card-body card-body-type text-center">
              <img src="/img/cartao.png" alt="Cartão">
              <h5>Vale Transporte</h5>
              <p>Fazemos o cadastro do seu vale transporte, contendo os serviços de consulta e recarga de valores.</p>
            </div>
          </div>
        </div>
        <!-- Você pode duplicar esse bloco depois -->
      </div>
    </div>

    <div class="linha mx-auto"></div>

    <!--Video-->
    <div class="row justify-content-center w-100">
      <div class="col-md-10">
        <div class="card card-home shadow-sm mb-3 h-100">
          <div class="card-body card-body-type text-center">
            <h5 style="margin-bottom: 30px;">Aqui você pode conferir um vídeo sobre a nossa plataforma!</h5>
            <iframe width="90%" height="400" src="https://www.youtube.com/embed/H9NSVePzUwU?si=aRbFxUQBkCH2pwWJ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          </div>
        </div>
      </div>
  </div>

    <%- include('../partials/footer') %>
</body>

</html>