<!DOCTYPE html>
<html>

<head>
  <title>Mapas</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="../img/logo.png">
  <link rel="stylesheet" href="/css/estilo.css">
</head>

<body>
    
<%- include('../partials/nav') %>

<main class="container my-4 flex-grow-1">
  <div class="mb-4">
    <h2 class="fw-bold">Mapas</h2>
    <p class="text-muted">Consulte a localização e visualize os mapas de referência.</p>
  </div>

  <div class="row g-4">
    <div class="col-md-4 col-lg-3">
      <div class="card border-0 shadow-sm p-3">
        <h5 class="fw-bold mb-3">Opções</h5>
        <label class="form-label">Pesquisar linha</label>
        <input type="text" class="form-control mb-3" placeholder="Ex: Linha 63">
        <label class="form-label">Ver seus horários</label>
        <a href="/horarios" class="btn cssbotao w-50">Horários</a>
      </div>
    </div>

        <!-- GOOGLE MAPS -->
        <div class="col-md-8 col-lg-9">

            <div class="card border-0 shadow-sm p-2">

                <iframe
                    src="https://maps.google.com/maps?q=Itu%2C%20SP&t=&z=13&ie=UTF8&iwloc=&output=embed"
                    width="100%"
                    height="500"
                    style="border:0; border-radius: 10px;"
                    loading="lazy"
                    allowfullscreen>
                </iframe>

            </div>

        </div>

    </div>

</main>

<%- include('../partials/footer') %>

</body>

</html>