<!DOCTYPE html>
<html>

<head>
  <title>Cadastro</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="../img/logo.png">
  <link rel="stylesheet" href="/css/estilo.css">
</head>

<body>
  <%- include('../partials/navsimples') %>
  <div class="container flex-grow-1">
    <div class="row">

      <div class="col" style="margin-top: 230px;">
        <img src="img/logo.png" alt="Logo">
        <div style="margin-top: 30px;">
          <h2>Bem-vindo!</h2>
          <h6>Crie sua conta hoje mesmo</h6>
        </div>
      </div>

      <div class="col">
        <div class="card-body" style="margin-top: 100px;">
          <h4 class="mb-3">Crie sua conta</h4>
          <form action="/cadastros/salvar" method="POST">
            <div class="mb-3">
              <label class="form-label">Nome de Usuário<span style="color: red;">*</span></label>
              <input type="text" name="nome" class="form-control form-control-lg caixinha-campo" placeholder="Nome de Usuário" required>
            </div>

            <div class="mb-3">
              <label class="form-label">E-mail<span style="color: red;">*</span></label>
              <input type="email" name="email" class="form-control form-control-lg caixinha-campo" placeholder="E-mail" required>
            </div>

            <div class="mb-3">
              <label class="form-label">Senha<span style="color: red;">*</span></label>
              <input type="password" name="senha" class="form-control form-control-lg caixinha-campo" placeholder="Senha" required>
              <small class="text-muted">A senha deve ter pelo menos 8 caracteres, incluindo pelo menos um número</small>
            </div>

            <div class="mb-3">
              <label class="form-label">Confirmar Senha<span style="color: red;">*</span></label>
              <input type="password" name="csenha" class="form-control form-control-lg caixinha-campo" placeholder="Senha" required>
            </div>

            <div class="d-grid">
              <button class="btn cssbotao" style="margin-top: 10px;">Cadastrar</button>
            </div>

            <div class="d-flex justify-content-center" style="margin-top: 10px;">
              <p>Já tem uma conta? <a href="/logins">Entre aqui</a></p>
            </div>

          </form>
        </div>
      </div>
    </div>
    <div class="accordion" id="accordionExample" style="margin-top: 30px;">
      <div class="accordion-item">

      <h2 class="accordion-header">
        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">Tabela somente para provar a funcionalidade de cadastro (não terá na versão final)</button>
      </h2>

        <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
          <div class="accordion-body">

            <!-- 🖥️ DESKTOP -->
            <div class="d-none d-md-block">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Senha</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% cadastros.forEach(cat => { %>
                            <tr>
                                <td><%= cat.id %></td>
                                <td><%= cat.nome %></td>
                                <td><%= cat.email %></td>
                                <td><%= cat.senha %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- 📱 MOBILE -->
            <div class="d-md-none">
                <% cadastros.forEach(cat => { %>
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">

                            <h5 class="card-title"><%= cat.nome %></h5>

                            <p class="card-text text-muted">
                                ID: <%= cat.id %>
                            </p>

                            <p class="card-text text-muted">
                                Email: <%= cat.email %>
                            </p>

                            <p class="card-text text-muted">
                                Senha: <%= cat.senha %>
                            </p>
                        </div>
                    </div>
                <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
</body>

</html>