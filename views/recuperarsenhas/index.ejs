<!DOCTYPE html>
<html>
<head>
    <title>Recuperar senha</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="../img/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/estilo.css">
</head>

<body>
    <%- include('../partials/navsimples') %>
    <!-- LOGIN CENTRALIZADO -->
    <div class="container flex-grow-1">
        <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
            <div style="width: 400px;">
                <div class="card-body card-body-type2">
                    <img src="img/logo.png" alt="Logo" class="d-block mx-auto">
                    <h2 class="mb-4 text-center">Recuperação de Senha</h2>
                    <p class="text-center">Redefina sua senha agora mesmo! Lembre-se de colocar a mesma senha nos dois campos.</p>
                    <form action="/recuperarsenhas/salvar" method="POST">
                        <div class="mb-3">
                            <input type="password" name="senha" class="form-control form-control-lg caixinha-campo mx-auto" style="width: 90%;" placeholder="Senha" required>
                        </div>

                        <div class="mb-3">
                            <input type="password" name="nsenha" class="form-control form-control-lg caixinha-campo mx-auto" style="width: 90%;" placeholder="Confirmar Senha" required>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-lg cssbotao">Redefinir</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/footer') %>
</body>
</html>