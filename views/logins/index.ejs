<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="../img/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/estilo.css">
</head>

<body>
    <%- include('../partials/navsimples') %>
    <!-- LOGIN CENTRALIZADO -->
    <div class="container flex-grow-1">
        <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
            <div style="width: 400px;">
                <div class="card-body card-body-type2">
                    <img src="img/logo.png" alt="Logo" class="d-block mx-auto">
                    <h2 class="mb-4 text-center">Seja bem-vindo de volta!</h2>
                    <form action="/logins/salvar" method="POST">
                        <div class="mb-3">
                            <input type="text" name="nome" class="form-control form-control-lg caixinha-campo mx-auto" style="width: 70%;" placeholder="Nome de Usuário" required>
                        </div>
                        <div class="mb-3">
                            <input type="password" name="senha" class="form-control form-control-lg caixinha-campo mx-auto" style="width: 70%;" placeholder="Senha" required>
                        </div>

                        <div class="d-flex justify-content-center">
                            <p><a href="/emailrecuperacoes">Esqueci minha senha</a></p>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-lg cssbotao">Entrar</button>
                        </div>

                        <div class="d-flex justify-content-center" style="margin-top: 10px;">
                            <p>Não tem uma conta? <a href="/cadastros">Crie uma</a></p>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/footer') %>
</body>
</html>