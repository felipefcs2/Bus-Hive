<!DOCTYPE html>
<html>

<head>
  <title>Vale Transporte</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="../img/logo.png">
  <link rel="stylesheet" href="/css/estilo.css">
</head>

<body>
  <%- include('../partials/nav') %>
    <div class="container mt-4">

      <div class="container py-5">
        <div class="mb-4">
            <h2>Meu cartão</h2>
            <p class="text-muted">Consulte seu saldo e faça recargas.</p>
        </div>
      <div class="row g-4">

        <div class="col-lg-5">
          <div class="card-body-type p-4 rounded-4 shadow">
            <div class="d-flex justify-content-between">
              <h5>BusHive</h5>
            </div>
            <p class="mt-4 mb-1">Saldo disponível:</p>
            <h1>R$50,00</h1> 
            <div class="mt-4"><small>Nome do Cartão:</small></div>
            <div><small>Número do Cartão:</small></div>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
              <h4>Adicionar saldo</h4>
                <p class="text-muted">Escolha o valor que deseja adicionar.</p>

                <div class="row g-2 mb-4">
                  <div class="col-4">
                    <button type="button" class="btn btn-outline-primary w-100 valor-btn" data-valor="10.00">R$ 10</button>
                  </div>
                  <div class="col-4">
                    <button type="button" class="btn btn-outline-primary w-100 valor-btn" data-valor="20.00">R$ 20</button>
                  </div>
                  <div class="col-4">
                    <button type="button" class="btn btn-outline-primary w-100 valor-btn" data-valor="50.00">R$ 50</button>
                  </div>
              </div>

              <form action="/cartaoinfos/salvar" method="POST">
                <label class="form-label">Valor da recarga</label>
                  <div class="input-group mb-4">
                    <span class="input-group-text">R$</span>
                    <input type="number" id="valorrecarga" name="valorrecarga" class="form-control" placeholder="0,00" min="1" max="500" step="0.01" required>
                  </div>

                <h5 class="mb-3">Método de pagamento</h5>
                  <div class="form-check border rounded-3 p-3 mb-2">
                    <input class="form-check-input" type="radio" name="metodoPagamento" id="pix" value="Pix" required>
                      <label class="form-check-label" for="pix"><img src="../../img/logopix.png" alt="Logo Pix" style="height: 20px; width: 20px;"> Pix</label>
                  </div>

                  <div class="form-check border rounded-3 p-3 mb-3">
                  <input class="form-check-input" type="radio" name="metodoPagamento" id="cartao" value="Cartão de crédito">
                      <label class="form-check-label" for="cartao"><i class="bi bi-credit-card me-2"></i>Cartão de Crédito</label>
                  </div>

                  <div id="areaPix" style="display: none;" class="text-center mb-3">
                    <p>QR Code para pagamento via Pix:</p>
                    <img src="../../img/qrcode.png" alt="QR Code ilustrativo" width="180">
                    <div><p>O QR Code para o pagamento expira em: <span id="contador"></span>.</p></div>
                  </div>

                  <div id="areaCartao" style="display: none;" class="mb-3">
                    <label for="cartaoID" class="form-label">Número do Cartão</label>
                    <input type="text" name="ncartaoc" id="cartaoID" class="form-control" placeholder="0000 0000 0000 0000" maxlength="19" inputmode="numeric" autocomplete="off">
                  </div>

                  <button type="submit" class="btn cssbotao w-100">Confirmar pagamento</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h4 class="mb-3">Últimas movimentações</h4>
            <p class="text-muted">Suas recargas e utilizações aparecerão aqui (Ilustrativo).</p>
            <div class="card p-3 mt-4">

            <div class="d-flex justify-content-between align-items-center border-bottom py-3">
            <div>
              <div class="fw-bold">
                  <i class="bi bi-ticket text-danger"></i> Gasto
              </div>
              <small class="text-muted">Passagem da linha 62 - Jacu via Taperinha</small>
          </div>
          <span class="text-danger fw-bold">- R$ 5,15</span>
      </div>

      <div class="d-flex justify-content-between align-items-center py-3">
          <div>
              <div class="fw-bold">
                  <i class="bi bi-plus-circle text-success"></i> Recarga
              </div>
              <small class="text-muted">Recarga via Pix</small>
          </div>
          <span class="text-success fw-bold">+ R$ 50,00</span>
      </div>
      </div>
    </div>
    </div>
      </div>

      <div class="row d-none d-md-flex">

        <div class="accordion" id="accordionCodigo" style="margin-top: 30px;">
        <div class="accordion-item">

        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCodigo" aria-expanded="true" aria-controls="collapseCodigo">Tabela somente para provar a funcionalidade de cadastro (não terá na versão final)</button>
        </h2>

            <div id="collapseCodigo" class="accordion-collapse collapse show" data-bs-parent="#accordionCodigo">
            <div class="accordion-body">

                <!-- 🖥️ DESKTOP -->
                <div class="d-none d-md-block">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Número do Cartão</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% cartaocadastros.forEach(cat => { %>
                                <tr>
                                    <td><%= cat.id %></td>
                                    <td><%= cat.nome %></td>
                                    <td><%= cat.ncartao %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- 📱 MOBILE -->
                <div class="d-md-none">
                    <% cartaocadastros.forEach(cat => { %>
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">

                                <h5 class="card-title"><%= cat.id %></h5>
                                <p class="card-text text-muted">
                                    Nome: <%= cat.nome %>
                                    Número do cartão: <%= cat.ncartao %>
                                </p>
                                
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
            </div>
        </div>
        </div>

        <!-- Você pode duplicar esse bloco depois -->
      </div>

      <div class="row d-none d-md-flex">

        <div class="accordion" id="accordionCodigo2" style="margin-top: 30px;">
        <div class="accordion-item">

        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCodigo2" aria-expanded="true" aria-controls="collapseCodigo2">Tabela somente para provar a funcionalidade de cadastro (não terá na versão final)</button>
        </h2>

            <div id="collapseCodigo2" class="accordion-collapse collapse show" data-bs-parent="#accordionCodigo2">
            <div class="accordion-body">

                <!-- 🖥️ DESKTOP -->
                <div class="d-none d-md-block">
                    <table class="table table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Numero do Cartão de Crédito</th>
                                <th>Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% cartaoinfo.forEach(cat => { %>
                                <tr>
                                    <td><%= cat.id %></td>
                                    <td><%= cat.ncartaoc %></td>
                                    <td><%= cat.valorrecarga %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- 📱 MOBILE -->
                <div class="d-md-none">
                    <% cartaoinfo.forEach(cat => { %>
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">

                                <h5 class="card-title"><%= cat.id %></h5>
                                <p class="card-text text-muted">
                                    Número do Cartão de Crédito: <%= cat.ncartaoc %>
                                    Valor: <%= cat.valorrecarga %>
                                </p>
                                
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
            </div>
        </div>
        </div>

        <!-- Você pode duplicar esse bloco depois -->
      </div>
    </div>

    <%- include('../partials/footer') %>
    <!--script dos botões azuis-->
    <script>
  document.querySelectorAll('.valor-btn').forEach(botao => {
    botao.addEventListener('click', () => {
      document.getElementById('valorrecarga').value =
          botao.dataset.valor;
        });
    });
    </script>
    <!--script de oculta as opções pix e cartão-->
    <script>
    const pix = document.getElementById("pix");
    const cartao = document.getElementById("cartao");

    const areaPix = document.getElementById("areaPix");
    const areaCartao = document.getElementById("areaCartao");

    const cartaoID = document.getElementById("cartaoID");

    pix.addEventListener("change", function() {
        areaPix.style.display = "block";
        areaCartao.style.display = "none";

        cartaoID.value = "0";
        cartaoID.required = false;
    });

    cartao.addEventListener("change", function() {
        areaPix.style.display = "none";
        areaCartao.style.display = "block";

        cartaoID.value = "";
        cartaoID.required = true;
    });

    cartaoID.addEventListener("input", function() {
        let cursor = this.selectionStart;

        let quantidadeNumeros = this.value
            .substring(0, cursor)
            .replace(/\D/g, "").length;

        let numeros = this.value
            .replace(/\D/g, "")
            .substring(0, 16);

        let formatado = numeros.match(/.{1,4}/g)?.join(" ") || "";

        this.value = formatado;

        let novaPosicao = 0;
        let contagem = 0;

        while (novaPosicao < formatado.length &&
               contagem < quantidadeNumeros) {
            if (/\d/.test(formatado[novaPosicao])) {
                contagem++;
            }
            novaPosicao++;
        }

        this.setSelectionRange(novaPosicao, novaPosicao);
    });

    document.querySelector("form").addEventListener("submit", function(event) {
        if (cartao.checked) {
            let numeros = cartaoID.value.replace(/\D/g, "");

            if (numeros.length !== 16) {
                event.preventDefault();
                alert("Digite os 16 números do cartão.");
                return;
            }

            cartaoID.value = numeros;
        }
    });
    </script>
    <!--script do contador-->
    <script>
    let tempoRestante = 30 * 60;
    const elementoContador = document.getElementById('contador');

    function atualizarContador() {
      const minutos = Math.floor(tempoRestante / 60);
      const segundos = tempoRestante % 60;

      const minFormatado = minutos < 10 ? '0' + minutos : minutos;
      const segFormatado = segundos < 10 ? '0' + segundos : segundos;

      elementoContador.textContent = `${minFormatado}:${segFormatado}`;

      if (tempoRestante > 0) {
        tempoRestante--;
      } else {
        clearInterval(intervalo);
        elementoContador.textContent = '00:00. Começe o processo novamente';
      }
    }

    const intervalo = setInterval(atualizarContador, 1000);
    </script>
</body>

</html>